winject.device        = 192.168.32.1
winject.console       = 22
winject.channel       = 1
# Channel 1-14; channel 14 is 802.11b (DSSS/CCK) only.
winject.modulation    = OFDM_24M
winject.power         = 20
winject.mode          = STANDALONE
winject.domain        = 1234
# Optional; omit/0 → 10000 kbps.
# winject.max_rate_kbps = 10000
# Local UDP console for runtime FEC / scheduler_budget / channel_info.
# Listen for replies: nc -u -l 127.0.0.1 2425
# Send command:     echo 'gci' | nc -u -w1 127.0.0.1 2424
# manager.console_in  = 127.0.0.1:2424
# manager.console_out = 127.0.0.1:2425

upstream.size = 2

upstream-0.mode             = UDP_GENERIC_FORWARDING
upstream-0.scheduler_budget = 100
upstream-0.rx               = 0.0.0.0:22081
upstream-0.tx               = 127.0.0.1:21082
upstream-0.tx_bus           = b2
upstream-0.rx_bus           = a1
# Optional. Same k/n on the peer manager.
# upstream-0.fec.type         = RS_BLOCK_ERASURE
# upstream-0.fec.k            = 10
# upstream-0.fec.n            = 15

upstream-1.mode             = TCP_SERVER_FORWARDING
upstream-1.scheduler_budget = 1024
upstream-1.rcv_buffer_size  = 16384
upstream-1.snd_buffer_size  = 16384
upstream-1.bind_address     = 127.0.0.1:22022
upstream-1.tx_bus           = c3
upstream-1.rx_bus           = d4
