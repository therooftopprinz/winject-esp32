# GStreamer defaults for host_x86 (video sink).
# Override any value in the environment before launching.

HOST=127.0.0.1
# ximagesink uses X11/WSLg and gets a normal decorated window (drag/resize).
SINK=ximagesink
GST_CAPS='application/x-rtp,media=(string)video,clock-rate=(int)90000,encoding-name=(string)H264,payload=(int)96'

# Ports must match config.cfg UDP connect addresses (RTP vs MPEG-TS).
UDP_PORT=21082
TCP_PORT=21083
