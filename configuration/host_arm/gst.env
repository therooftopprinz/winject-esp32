# GStreamer defaults for host_arm (camera source).
# Override any value in the environment before launching.
# BITRATE is kbps.

DEVICE=/dev/video0
HOST=127.0.0.1
WIDTH=1280
HEIGHT=720

# Capture is the UVC caps rate. Encoder is after videorate (drop-only).
CAPTURE_FRAMERATE=30/1
ENCODER_FRAMERATE=30/1
BITRATE=6000
GOP=10
FORMAT=auto
MTU=1400

# Ports must match config.cfg UDP bind addresses (RTP vs MPEG-TS).
UDP_PORT=22081
TCP_PORT=22082
