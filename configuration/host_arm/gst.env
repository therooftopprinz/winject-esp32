# GStreamer defaults for host_arm (camera source).
# Override any value in the environment before launching.
# BITRATE is kbps.

DEVICE=/dev/video0
HOST=127.0.0.1
WIDTH=1280
HEIGHT=720
FRAMERATE=30/1
BITRATE=4000
GOP=150
FORMAT=auto
MTU=1400

# Ports must match config.cfg UDP bind addresses (RTP vs MPEG-TS).
UDP_PORT=22081
TCP_PORT=22082
